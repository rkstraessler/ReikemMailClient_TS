{
  "name": "@reikem/mail-client",
  "version": "2.0.0",
  "description": "TypeScript SDK for the REIKEM Mail API v2. Send email, submit personalized batches, query mail history, and download files.",
  "keywords": [
    "reikem-mail",
    "email",
    "email-api",
    "mail-client",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkstraessler/ReikemMailClient_TS.git"
  },
  "packageManager": "bun@1.4.4",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/EmailAPIClient.js",
  "types": "./dist/EmailAPIClient.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/EmailAPIClient.d.ts",
      "import": "./dist/EmailAPIClient.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "bun -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && bun x tsc",
    "typecheck": "bun x tsc -p tsconfig.type-tests.json",
    "test": "bun test",
    "lint": "oxlint src test .github/scripts",
    "format": "bun --no-env-file .github/scripts/ci/format.ts fix",
    "format:check": "bun --no-env-file .github/scripts/ci/format.ts check",
    "test:automation": "bun test ./.github/scripts",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run test:automation && bun run pack:check",
    "prepare": "bun run build",
    "pack:check": "bun pm pack --dry-run"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.11",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2"
  }
}
